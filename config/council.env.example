# AI Council - API Keys (optional)
# Only needed if AUTH_MODE="apikey" in council.conf
# Most users should use AUTH_MODE="oauth" instead (the default),
# which mounts your existing CLI credentials from the host.
#
# To use API keys instead:
#   1. Set AUTH_MODE="apikey" in council.conf
#   2. Copy this file: cp council.env.example council.env
#   3. Fill in your keys below

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here
