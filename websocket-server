// Types from the reversed protocol
type MessageType = 
  | 'user' | 'system' | 'assistant' | 'result' | 'stream_event' 
  | 'control_request' | 'control_response' | 'control_cancel_request'
  | 'keep_alive' | 'tool_progress' | 'tool_use_summary' | 'auth_status'
  | 'update_environment_variables'

type ControlRequestSubtype = 
  | 'initialize' | 'can_use_tool' | 'interrupt' | 'set_permission_mode'
  | 'set_model' | 'set_max_thinking_tokens' | 'mcp_status' | 'mcp_message'
  | 'mcp_reconnect' | 'mcp_toggle' | 'mcp_set_servers' | 'rewind_files'
  | 'hook_callback'

interface BaseMessage {
  type: MessageType
  session_id: string
  uuid?: string
}

interface UserMessage extends BaseMessage {
  type: 'user'
  message: {
    role: 'user'
    content: string | ContentBlock[]
  }
  parent_tool_use_id: string | null
}

interface SystemInitMessage extends BaseMessage {
  type: 'system'
  subtype: 'init'
  cwd: string
  tools: string[]
  model: string
  permissionMode: string
  session_id: string
  uuid: string
}

interface AssistantMessage extends BaseMessage {
  type: 'assistant'
  message: {
    id: string
    type: 'message'
    role: 'assistant'
    model: string
    content: ContentBlock[]
    stop_reason: string | null
    usage: {
      input_tokens: number
      output_tokens: number
      cache_creation_input_tokens: number
      cache_read_input_tokens: number
    }
  }
  parent_tool_use_id: string | null
  error?: string
}

interface ControlRequestMessage extends BaseMessage {
  type: 'control_request'
  request_id: string
  request: {
    subtype: ControlRequestSubtype
    [key: string]: any
  }
}

interface ControlResponseMessage extends BaseMessage {
  type: 'control_response'
  response: {
    subtype: 'success' | 'error'
    request_id: string
    response?: any
    error?: string
  }
}

type ContentBlock = 
  | { type: 'text'; text: string }
  | { type: 'tool_use'; id: string; name: string; input: Record<string, unknown> }
  | { type: 'tool_result'; tool_use_id: string; content: string | ContentBlock[]; is_error?: boolean }
  | { type: 'thinking'; thinking: string; budget_tokens?: number }

// Session management
class SessionManager {
  private sessions: Map<string, SessionState>
  
  constructor() {
    this.sessions = new Map()
  }
  
  createSession(sessionId: string, initData: SystemInitMessage): SessionState {
    const state: SessionState = {
      sessionId,
      createdAt: new Date(),
      lastActivity: new Date(),
      model: initData.model,
      tools: initData.tools,
      permissionMode: initData.permissionMode,
      cwd: initData.cwd,
      messages: [],
      pendingPermissionRequests: new Map(),
      isActive: true
    }
    
    this.sessions.set(sessionId, state)
    return state
  }
  
  getSession(sessionId: string): SessionState | undefined {
    return this.sessions.get(sessionId)
  }
  
  updateSession(sessionId: string, updates: Partial<SessionState>): SessionState | undefined {
    const session = this.sessions.get(sessionId)
    if (!session) return undefined
    
    Object.assign(session, updates)
    session.lastActivity = new Date()
    return session
  }
  
  addPermissionRequest(sessionId: string, requestId: string, request: any): void {
    const session = this.sessions.get(sessionId)
    if (session) {
      session.pendingPermissionRequests.set(requestId, request)
    }
  }
  
  resolvePermissionRequest(sessionId: string, requestId: string): void {
    const session = this.sessions.get(sessionId)
    if (session) {
      session.pendingPermissionRequests.delete(requestId)
    }
  }
  
  addMessage(sessionId: string, message: any): void {
    const session = this.sessions.get(sessionId)
    if (session) {
      session.messages.push(message)
      session.lastActivity = new Date()
    }
  }
}

interface SessionState {
  sessionId: string
  createdAt: Date
  lastActivity: Date
  model: string
  tools: string[]
  permissionMode: string
  cwd: string
  messages: any[]
  pendingPermissionRequests: Map<string, any>
  isActive: boolean
}

// Permission engine
class PermissionEngine {
  constructor(private sessionManager: SessionManager) {}
  
  async handlePermissionRequest(sessionId: string, requestId: string, request: any): Promise<ControlResponseMessage> {
    const session = this.sessionManager.getSession(sessionId)
    if (!session) {
      return this.createErrorResponse(requestId, 'Session not found')
    }
    
    // Store the pending request
    this.sessionManager.addPermissionRequest(sessionId, requestId, request)
    
    try {
      // Implement your permission logic here
      // For now, auto-approve everything (demo purposes)
      const response = this.autoApproveStrategy(request)
      
      // Resolve the pending request
      this.sessionManager.resolvePermissionRequest(sessionId, requestId)
      
      return this.createSuccessResponse(requestId, response)
    } catch (error) {
      return this.createErrorResponse(requestId, error instanceof Error ? error.message : 'Unknown error')
    }
  }
  
  private autoApproveStrategy(request: any): any {
    // Simple auto-approve strategy - modify for your needs
    return {
      behavior: 'allow',
      updatedInput: request.input || {},
      updatedPermissions: []
    }
  }
  
  private createSuccessResponse(requestId: string, response: any): ControlResponseMessage {
    return {
      type: 'control_response',
      session_id: '', // Will be filled by caller
      response: {
        subtype: 'success',
        request_id: requestId,
        response
      }
    }
  }
  
  private createErrorResponse(requestId: string, error: string): ControlResponseMessage {
    return {
      type: 'control_response',
      session_id: '', // Will be filled by caller
      response: {
        subtype: 'error',
        request_id: requestId,
        error
      }
    }
  }
}

