// WebSocket message handler
class WebSocketMessageHandler {
  constructor(
    private sessionManager: SessionManager,
    private permissionEngine: PermissionEngine,
    private debateCoordinator: DebateModeCoordinator
  ) {}
  
  async handleMessage(ws: any, message: any, rawData: string): Promise<void> {
    try {
      const parsed = JSON.parse(rawData)
      
      // Add session_id if missing (for responses)
      if (!parsed.session_id && message.session_id) {
        parsed.session_id = message.session_id
      }
      
      this.sessionManager.addMessage(parsed.session_id, parsed)
      
      switch (parsed.type) {
        case 'system':
          await this.handleSystemMessage(ws, parsed)
          break
        case 'assistant':
          await this.handleAssistantMessage(ws, parsed)
          break
        case 'result':
          await this.handleResultMessage(ws, parsed)
          break
        case 'stream_event':
          await this.handleStreamEvent(ws, parsed)
          break
        case 'control_request':
          await this.handleControlRequest(ws, parsed)
          break
        case 'keep_alive':
          // Ignore keep-alive messages
          break
        default:
          console.log(`Unhandled message type: ${parsed.type}`)
      }
    } catch (error) {
      console.error('Error handling message:', error)
    }
  }
  
  private async handleSystemMessage(ws: any, message: SystemInitMessage): Promise<void> {
    console.log(`System init received: session=${message.session_id}, model=${message.model}`)
    
    // Create or update session
    const existingSession = this.sessionManager.getSession(message.session_id)
    if (!existingSession) {
      this.sessionManager.createSession(message.session_id, message)
    } else {
      this.sessionManager.updateSession(message.session_id, {
        model: message.model,
        tools: message.tools,
        permissionMode: message.permissionMode
      })
    }
    
    // Send first user message (example)
    const firstPrompt = {
      type: 'user' as const,
      message: {
        role: 'user' as const,
        content: 'Analyze this codebase and suggest improvements. Be thorough and provide specific recommendations.'
      },
      parent_tool_use_id: null,
      session_id: message.session_id,
      uuid: crypto.randomUUID()
    }
    
    ws.send(JSON.stringify(firstPrompt) + '\n')
  }
  
  private async handleAssistantMessage(ws: any, message: AssistantMessage): Promise<void> {
    const content = message.message.content
      .filter((block: ContentBlock) => block.type === 'text')
      .map((block: any) => block.text)
      .join(' ')
    
    console.log(`Assistant response: ${content.substring(0, 100)}${content.length > 100 ? '...' : ''}`)
    
    // Check if this contains tool use that might need permission
    const toolUses = content.match(/\b(tool_use|ToolUse)\b/i)
    if (toolUses) {
      console.log('Tool use detected in assistant response')
    }
  }
  
  private async handleResultMessage(ws: any, message: any): Promise<void> {
    console.log(`Result received: ${message.subtype}, cost=$${message.total_cost_usd}, turns=${message.num_turns}`)
    
    if (message.is_error) {
      console.error('Error result:', message.errors)
    } else {
      // Could start multi-turn conversation or debate mode here
      // For now, just log and potentially send another user message
      console.log('Query completed successfully')
    }
  }
  
  private async handleStreamEvent(ws: any, message: any): Promise<void> {
    // Handle real-time streaming for TUI
    // Extract text content and send to terminal
    if (message.event && message.event.type === 'content_block_delta') {
      const text = message.event.delta?.text
      if (text) {
        // In a real TUI, this would update the terminal display
        process.stdout.write(text)
      }
    }
  }
  
  private async handleControlRequest(ws: any, message: ControlRequestMessage): Promise<void> {
    console.log(`Control request: ${message.request.subtype}`)
    
    switch (message.request.subtype) {
      case 'can_use_tool':
        await this.handlePermissionRequest(ws, message)
        break
      case 'initialize':
        await this.handleInitializeRequest(ws, message)
        break
      case 'interrupt':
        await this.handleInterruptRequest(ws, message)
        break
      default:
        console.log(`Unhandled control request: ${message.request.subtype}`)
    }
  }
  
  private async handlePermissionRequest(ws: any, message: ControlRequestMessage): Promise<void> {
    const response = await this.permissionEngine.handlePermissionRequest(
      message.session_id,
      message.request_id,
      message.request
    )
    
    // Fill in session_id
    response.session_id = message.session_id
    
    ws.send(JSON.stringify(response) + '\n')
  }
  
  private async handleInitializeRequest(ws: any, message: ControlRequestMessage): Promise<void> {
    // Handle initialization control request
    const response = {
      type: 'control_response' as const,
      session_id: message.session_id,
      response: {
        subtype: 'success' as const,
        request_id: message.request_id,
        response: {
          // Return available commands, models, etc.
          commands: [],
          output_style: 'default',
          available_output_styles: ['default', 'compact'],
          models: [
            { value: 'claude-3-opus-20240229', displayName: 'Claude 3 Opus', description: 'Most powerful model' },
            { value: 'claude-3-sonnet-20240229', displayName: 'Claude 3 Sonnet', description: 'Balanced model' }
          ],
          account: {}
        }
      }
    }
    
    ws.send(JSON.stringify(response) + '\n')
  }
  
  private async handleInterruptRequest(ws: any, message: ControlRequestMessage): Promise<void> {
    const response = {
      type: 'control_response' as const,
      session_id: message.session_id,
      response: {
        subtype: 'success' as const,
        request_id: message.request_id,
        response: {}
      }
    }
    
    ws.send(JSON.stringify(response) + '\n')
  }
}

// Main server setup
function createServer() {
  const app = new Hono()
  
  // Shared state
  const sessionManager = new SessionManager()
  const permissionEngine = new PermissionEngine(sessionManager)
  const debateCoordinator = new DebateModeCoordinator(sessionManager)
  const messageHandler = new WebSocketMessageHandler(sessionManager, permissionEngine, debateCoordinator)
  
  // WebSocket upgrade endpoint
  app.get('/ws', (c) => {
    const success = upgradeWebSocket(c, (ws) => {
      console.log('New WebSocket connection established')
      
      ws.on('message', async (data, rawData) => {
        try {
          // Handle NDJSON - multiple messages can be in one WebSocket message
          const lines = rawData.toString().split('\n').filter(Boolean)
          
          for (const line of lines) {
            if (line.trim()) {
              const message = JSON.parse(line)
              await messageHandler.handleMessage(ws, message, line)
            }
          }
        } catch (error) {
          console.error('Error processing WebSocket message:', error)
        }
      })
      
      ws.on('close', () => {
        console.log('WebSocket connection closed')
      })
      
      ws.on('error', (error) => {
        console.error('WebSocket error:', error)
      })
    })
    
    if (!success) {
      return c.text('WebSocket upgrade failed', 400)
    }
    
    return new Response(null, { status: 101 })
  })
  
  // Health check endpoint
  app.get('/health', (c) => {
    return c.json({ status: 'healthy', activeSessions: Array.from(sessionManager['sessions'].keys()).length })
  })
  
  // Static files for any UI
  app.use('/static/*', serveStatic({ root: './public' }))
  
  return app
}

